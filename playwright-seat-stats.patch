+/**
+ * Seat Counter Helper
+ *
+ * Calculates venue capacity and seats for sale from Ticketmaster API responses.
+ */
+
+/**
+ * Count total seats in venue from Map API response (venue capacity)
+ * @param {Object} mapData - Response from mapsapi.tmol.io
+ * @returns {number} Total number of seats in the venue
+ */
+export function countVenueCapacity(mapData) {
+  let totalSeats = 0;
+
+  if (!mapData || !mapData.pages || !mapData.pages.length) {
+    return 0;
+  }
+
+  try {
+    const page = mapData.pages[0];
+    if (!page.segments) return 0;
+
+    // Traverse the nested structure: pages -> segments -> segments (sections) -> segments (rows) -> placesNoKeys
+    page.segments.forEach((composit) => {
+      if (composit?.segments) {
+        composit.segments.forEach((section) => {
+          if (section.segments && section.segments.length > 0) {
+            // Has rows
+            section.segments.forEach((row) => {
+              if (row.placesNoKeys && Array.isArray(row.placesNoKeys)) {
+                totalSeats += row.placesNoKeys.length;
+              }
+            });
+          } else if (section.placesNoKeys && Array.isArray(section.placesNoKeys)) {
+            // General Admission - seats directly under section
+            totalSeats += section.placesNoKeys.length;
+          }
+        });
+      }
+    });
+  } catch (error) {
+    console.error('[SeatCounter] Error counting venue capacity:', error.message);
+  }
+
+  return totalSeats;
+}
+
+/**
+ * Count total seats for sale from Facet API response
+ * @param {Object} facetData - Response from services.ticketmaster.com facets API
+ * @returns {number} Total number of individual seats for sale
+ */
+export function countSeatsForSale(facetData) {
+  let totalSeats = 0;
+
+  if (!facetData || !facetData.facets || !Array.isArray(facetData.facets)) {
+    return 0;
+  }
+
+  try {
+    facetData.facets.forEach((facet) => {
+      if (facet.places && Array.isArray(facet.places)) {
+        // Each facet has compressed place codes
+        // We need to decompress and count them
+        facet.places.forEach((placeString) => {
+          // The places are in a compressed format like "[1,2,3]" or nested
+          // Count the actual seat IDs
+          const seatCount = countPlacesInString(placeString);
+          totalSeats += seatCount;
+        });
+      }
+    });
+  } catch (error) {
+    console.error('[SeatCounter] Error counting seats for sale:', error.message);
+  }
+
+  return totalSeats;
+}
+
+/**
+ * Count seats in a compressed place string
+ * Place strings can be like: "ABC123" or "[ABC123,ABC124]" or nested
+ * @param {string} placeString - Compressed place string
+ * @returns {number} Number of seats in the string
+ */
+function countPlacesInString(placeString) {
+  if (!placeString || typeof placeString !== 'string') {
+    return 0;
+  }
+
+  // Simple approach: count by parsing the structure
+  // The string format is like nested arrays: [a[b,c],d[e,f]]
+  // Each leaf node is a seat
+
+  let count = 0;
+  let depth = 0;
+  let currentToken = '';
+
+  for (let i = 0; i < placeString.length; i++) {
+    const char = placeString[i];
+
+    if (char === '[') {
+      depth++;
+    } else if (char === ']') {
+      if (currentToken.length > 0) {
+        count++;
+        currentToken = '';
+      }
+      depth--;
+    } else if (char === ',') {
+      if (currentToken.length > 0) {
+        count++;
+        currentToken = '';
+      }
+    } else {
+      currentToken += char;
+    }
+  }
+
+  // Handle case where there's a token at the end
+  if (currentToken.length > 0) {
+    count++;
+  }
+
+  // If no brackets, it's a single seat
+  if (count === 0 && placeString.length > 0) {
+    count = 1;
+  }
+
+  return count;
+}
+
+/**
+ * Get both capacity and seats for sale in one call
+ * @param {Object} mapData - Response from Map API
+ * @param {Object} facetData - Response from Facet API
+ * @returns {Object} { venueCapacity, seatsForSale }
+ */
+export function getSeatStats(mapData, facetData) {
+  return {
+    venueCapacity: countVenueCapacity(mapData),
+    seatsForSale: countSeatsForSale(facetData)
+  };
+}
+
+export default {
+  countVenueCapacity,
+  countSeatsForSale,
+  getSeatStats
+};
