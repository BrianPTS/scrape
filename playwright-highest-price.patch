         attributes: x?.attributes,
@@ -412,6 +449,7 @@ export const AttachRowSection = (
         seats: seatsInRow,
         eventId: seatGroup.eventId,
         offerId: seatGroup.offerId,
+        allOfferIds: seatGroup.allOfferIds, // NEW: Preserve all offer IDs for price comparison
         accessibility: seatGroup.accessibility,
         descriptionId: seatGroup.descriptionId,
         attributes: seatGroup.attributes,
@@ -462,7 +500,16 @@ export const AttachRowSection = (
 
   const finalData = returnData
       .map((x) => {
-        let offerGet = offers.find((e) => e.offerId == x.offerId);
+        // Use highest priced offer when multiple offers exist for the same seat
+        // This ensures we always use the adult/standard price, not kids/promo prices
+        let offerGet;
+        if (x.allOfferIds && x.allOfferIds.length > 1) {
+          // Multiple offers available - select highest priced one
+          offerGet = selectHighestPricedOffer(x.allOfferIds, offers);
+        } else {
+          // Single offer or no allOfferIds - use original logic
+          offerGet = offers.find((e) => e.offerId == x.offerId);
+        }
 
         // Check accessibility exclusion filters first
         if (GLOBAL_FILTERS.excludeAccessibility) {
