Date: Fri, 6 Feb 2026 15:32:58 +0000
Subject: [PATCH] Fix: Always use highest price when seat has multiple offers

When a seat has multiple price options (e.g., Standard $45 + Kids $0),
the scraper now always selects the offer with the highest total price
(faceValue + charges).

Changes:
- seats.js: Pass all offer IDs instead of selecting by shortest string
- seatBatch.js: Add selectHighestPricedOffer() function to choose
  the highest priced offer from multiple options
- Preserve allOfferIds through all data transformations

This ensures the CSV always contains the adult/standard price,
not promotional or kids ticket prices.

https://claude.ai/code/session_015XRotx8uwwAdupB9MxLRfN
---
 helpers/seatBatch.js | 51 ++++++++++++++++++++++++++++++++++++++++++--
 helpers/seats.js     | 12 +++++------
 2 files changed, 55 insertions(+), 8 deletions(-)

diff --git a/helpers/seatBatch.js b/helpers/seatBatch.js
index cb935fe..93e0b1a 100644
--- a/helpers/seatBatch.js
+++ b/helpers/seatBatch.js
@@ -1,7 +1,42 @@
 import moment from "moment";
 import { formatInHandDate } from "../utils/dateUtils.js";
 import * as fs from 'fs';
-// Function to generate unique 10-digit inventory ID
+
+/**
+ * Select the offer with the highest price from multiple offer IDs
+ * @param {Array<string>} offerIds - Array of offer IDs
+ * @param {Array<Object>} allOffers - Array of all offer objects with prices
+ * @returns {Object|null} The offer with the highest price, or null if none found
+ */
+function selectHighestPricedOffer(offerIds, allOffers) {
+  if (!offerIds || offerIds.length === 0 || !allOffers || allOffers.length === 0) {
+    return null;
+  }
+
+  // Find all matching offers
+  const matchingOffers = offerIds
+    .map(id => allOffers.find(o => o.offerId === id))
+    .filter(Boolean);
+
+  if (matchingOffers.length === 0) {
+    return null;
+  }
+
+  // If only one offer, return it
+  if (matchingOffers.length === 1) {
+    return matchingOffers[0];
+  }
+
+  // Select the offer with the highest total price (faceValue + charges)
+  return matchingOffers.reduce((highest, current) => {
+    const currentTotal = (current.faceValue || 0) +
+      (current.charges?.reduce((sum, c) => sum + (c.amount || 0), 0) || 0);
+    const highestTotal = (highest.faceValue || 0) +
+      (highest.charges?.reduce((sum, c) => sum + (c.amount || 0), 0) || 0);
+
+    return currentTotal > highestTotal ? current : highest;
+  }, matchingOffers[0]);
+}
 
 // Global Filters
